# Copy this file to .env and adjust values as needed.
# .env is git-ignored; .env.example is the source of truth for required variables.

# --- Database ---
DB_NAME=financeapp
DB_USER=financeapp
DB_PASSWORD=financeapp
# Host/port as seen by a process running OUTSIDE docker-compose (e.g. backend run via IDE/Gradle).
# Inside docker-compose, the backend service always talks to the "postgres" service on 5432.
DB_HOST=localhost
DB_PORT=5432

# --- Backend ---
SERVER_PORT=8080

# --- Frontend ---
# GraphQL endpoint the browser (Vite dev server) talks to.
VITE_GRAPHQL_URL=http://localhost:8080/graphql
